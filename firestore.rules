rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /readings/{readingId} {
      allow read: if true;
      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'nodeId',
          'temperature',
          'humidity',
          'pressureHpa',
          'noiseDb',
          'createdAt'
        ])
        && request.resource.data.keys().hasOnly([
          'nodeId',
          'temperature',
          'humidity',
          'pressureHpa',
          'noiseDb',
          'createdAt'
        ])
        && request.resource.data.nodeId is string
        && request.resource.data.nodeId.size() > 0
        && (request.resource.data.temperature is number || request.resource.data.temperature == null)
        && (request.resource.data.humidity is number || request.resource.data.humidity == null)
        && (request.resource.data.pressureHpa is number || request.resource.data.pressureHpa == null)
        && (request.resource.data.noiseDb is number || request.resource.data.noiseDb == null)
        && request.resource.data.createdAt is timestamp;

      allow update, delete: if false;
    }
  }
}
